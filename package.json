{
  "name": "grnted",
  "license": "AGPL-3.0-only",
  "version": "0.3.4",
  "description": "Open-source website accessibility checker for WCAG 2.2 A and AA: a 0-100 score and a result for every criterion. Found the most planted failures of eight open-source checkers in a blind test.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "axe-core",
    "cli",
    "accessibility-testing",
    "accessibility-checker",
    "wcag2",
    "a11y-testing",
    "playwright"
  ],
  "type": "module",
  "bin": {
    "grnted": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pdf": {
      "types": "./dist/documents/pdf.d.ts",
      "import": "./dist/documents/pdf.js"
    },
    "./lib/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "playwright": "1.61.1",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "author": "Tyrannosaurx LLC",
  "homepage": "https://grnted.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grnted/grnted.git"
  },
  "bugs": {
    "url": "https://github.com/grnted/grnted/issues"
  }
}
